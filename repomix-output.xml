/* ===== GLOBAL RESET & VARIABLES ===== */
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --bg: #000;
  --bg1: #080808;
  --bg2: #0d0d0d;
  --bg3: #111;
  --card: #141414;
  --border: #1e1e1e;
  --border2: #2a2a2a;
  --text1: #f5f5f5;
  --text2: #8a8a8a;
  --text3: #444;
  --accent: #e8e8e8;
  --hl: #fff;
  --font: "Outfit", sans-serif;
  --mono: "JetBrains Mono", monospace;
  --sg: "Space Grotesk", sans-serif;
  --ease: cubic-bezier(.22, 1, .36, 1);
  --blue: #4da3ff;
  --card-hover-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  --btn-hover-transform: translateY(-2px);
}

:root.light {
  --bg: #f8f9fa;
  --bg1: #ffffff;
  --bg2: #f1f3f5;
  --bg3: #e9ecef;
  --card: #ffffff;
  --border: #dee2e6;
  --border2: #ced4da;
  --text1: #212529;
  --text2: #495057;
  --text3: #6c757d;
  --accent: #e8e8e8;
  --hl: #000000;
  --blue: #1a56db;
  --card-hover-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

body,
body * {
  transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

html {
  scroll-behavior: smooth;
  background: var(--bg);
  color-scheme: dark;
}
html.light {
  color-scheme: light;
}

body {
  background: var(--bg);
  color: var(--text1);
  font-family: var(--font);
  font-size: 15px;
  line-height: 1.65;
  overflow-x: hidden;
}

::-webkit-scrollbar {
  width: 3px;
}
::-webkit-scrollbar-track {
  background: var(--bg);
}
::-webkit-scrollbar-thumb {
  background: var(--border2);
}

.wrap {
  max-width: 1080px;
  margin: 0 auto;
  padding: 0 36px;
}
@media (max-width: 640px) {
  .wrap {
    padding: 0 20px;
  }
}

/* ===== THEME SWITCH (circle from the centre of the screen) =====
   To light: a circle opens from the centre outwards.
   To dark:  a circle closes from the edges in to the centre. */
::view-transition-old(root),
::view-transition-new(root) {
  animation: none;
  mix-blend-mode: normal;
}
html[data-vt="to-light"]::view-transition-old(root) { z-index: 1; }
html[data-vt="to-light"]::view-transition-new(root) { z-index: 2; clip-path: circle(0px at 50% 50%); }
html[data-vt="to-dark"]::view-transition-new(root) { z-index: 1; }
html[data-vt="to-dark"]::view-transition-old(root) { z-index: 2; }

/* While the circle plays, every normal hover/colour transition is switched off.
   Otherwise elements keep fading to their new colours after the circle has
   finished, which is the "flash" that appeared a second later. */
html.theme-switching *,
html.theme-switching *::before,
html.theme-switching *::after {
  transition: none !important;
}
/* Browsers without View Transitions get a slow, even cross-fade instead */
html.theme-fade,
html.theme-fade * {
  transition: background-color .7s ease, color .7s ease, border-color .7s ease !important;
}

